// Online C compiler to run C program online
#include <stdio.h>
#include <math.h>
int main()
{
    int n,rem,even=0,odd=0;
    printf("enter number:");
    scanf("%d",&n);
    while(n!=0)
        {
            rem=n%10;
            if(rem%2==0)
            even=even+1;
            else if(rem%2!=0)
            odd=odd+1;
            n=n/10;
        }
    printf("odd:%d  even:%d",odd,even);

}
