#include <stdio.h>
int main()
{
    char  a[10],ch;
    int i,j,count=0;
    for(i=0;i<10;i++)
        {
            printf("enter the answer: ");
            scanf(" %c",&ch);
            a[i]=ch;
        }
    char b[3][10],val;
    for(i=0;i<3;i++)
            {
                for(j=0;j<10;j++)
                    {
                        printf("enter val:");
                        scanf(" %c",&val);
                        b[i][j]=val;
                    }
            }
    for(i=0;i<3;i++)
            {
                count=0;
                for(j=0;j<10;j++)
                    {
                        if(b[i][j]==a[j])
                            count=count+1;
                    }
                printf("score of student%d:%d\n",i,count);
            }
}
