#include <stdio.h>

int main()
{
    int m, p, c, tot, i, sum2, count;

    count = 0;

    for(i = 1; i <= 3; i++)
    {
        printf("Enter marks in math, phy, chem: ");
        scanf("%d %d %d", &m, &p, &c);

        tot = m + p + c;
        sum2 = m + p;

        if ((m >= 60 && p >= 50 && c >= 40) &&
            (tot >= 200 || sum2 >= 150))
        {
            count = count + 1;
        }
    }

    printf("Eligible candidates: %d", count);

    return 0;
}
