#include <stdio.h>
int main()
{
    int a=5678,rem,rev=0,i,j,b,temp;
    while(a!=0)
        {
            rem=a%10;
            rev=(rev*10)+rem;
            a=a/10;
        }
    temp=rev;
    for(i=1;i<=4;i++)
        {
            
            for(j=4;j>=i;j--)
                {
                    b=rev%10;
                    printf("%d",b);
                    rev=rev/10;
                }
            printf("\n");
            temp=temp/10;
            rev=temp;
        }

    
}
