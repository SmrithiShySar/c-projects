#include <stdio.h>
int main()
{
    float unit,amount;
    printf("enter the units consumed:");
    scanf("%f",&unit);
    int calc()
    {
        if (unit<=200)
        amount=unit*0.5;
        else if (unit<=400)
        amount=100+(unit*0.65);
        else if (unit<=600)
        amount=230+(unit*0.80);
        else if (unit<=600)
        amount=390+(unit*1.0);
        printf("Total amount:%f",amount);
    }
    calc();
    return 0;    
}
