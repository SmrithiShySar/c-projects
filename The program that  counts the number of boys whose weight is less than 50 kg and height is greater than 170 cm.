// Online C compiler to run C program online
#include <stdio.h>
int main()
{
    float height,weight,i;
    int count;
    count=0;
    for (i=1;i<=5;i++)
    {
      printf("Enter weight:");
      scanf("%f",&weight);
      printf("Enter height:");
      scanf("%f",&height);
      if (weight<50 && height>170)
      {
        count=count+1;
      }
    }
    printf("No of boys whose height<50 and weight>170:%d",count);
    return 0;
}
