// Online C compiler to run C program online
#include <stdio.h>
#include <math.h>
int main()
{
    int bin,oct,i,n,sum,b,tot=0,place;
    printf("enter binary number:");
    scanf("%d",&bin);
    place=1;
    while(bin!=0)
        {
            n=bin%1000;
            sum=0;
            for(i=0;i<=2;i++)
                {
                    b=n%10;
                    sum=sum+b*pow(2,i);
                    n=n/10;
                    
                }
            tot=tot+(sum*place);
            place=place*10;
            bin=bin/1000;
        }
    printf("octal number:%d",tot);
}  
