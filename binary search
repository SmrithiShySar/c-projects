#include <stdio.h>
#include <math.h>
int main()
{
    int a[5]={5,10,15,20,25},i,ele,low,high,mid;
    printf("enter the element");
    scanf("%d",&ele);
    low=0;
    high=4;
    while(low<=high)
        {
            mid=(low+high)/2;
            if(a[mid]==ele)
            {
                printf("found");
            }
            else if(ele<a[mid])
            {
                high=mid-1;
            }
            else if(ele>a[mid])
            {
                low=mid+1;
            }
            
        }
}
