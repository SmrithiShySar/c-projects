#include <stdio.h>
int main()
{
    int a,b,no1,no2,gcd,i,j;
    printf("enter number a and b:");
    scanf("%d %d",&a,&b);
    
    for (i=1,j=1;i<=a,j<=b;i++,j++)
    {
        if(a%i==0)
        no1=i;
        if(b%j==0)
        no2=j;
        if(no1==no2)
        gcd=no1;
    }
    printf("GCD=%d",gcd);
}
